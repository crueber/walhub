#!/bin/sh
# walhub credential helper for {{.Host}} (get/store/erase)
SLUG="{{.Slug}}"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/git"
TOKEN_FILE="$CONF_DIR/$SLUG-token"
case "$1" in
get)
  if [ -n "${WALGIT_TOKEN:-}" ]; then
    echo "capability[]=authtype"
    echo "authtype=Bearer"
    echo "credential=$WALGIT_TOKEN"
    echo "username=token"
    echo "password=$WALGIT_TOKEN"
    exit 0
  fi
  if [ ! -f "$TOKEN_FILE" ]; then
    echo "error: no token; mint one at {{.Base}}/_auth/tokens" >&2
    exit 1
  fi
  TOKEN=$(cat "$TOKEN_FILE")
  echo "capability[]=authtype"
  echo "authtype=Bearer"
  echo "credential=$TOKEN"
  echo "username=token"
  echo "password=$TOKEN"
  ;;
store)
  P=$(sed -n 's/^password=//p' | head -n 1)
  umask 077
  printf '%s' "$P" > "$TOKEN_FILE.tmp"
  mv "$TOKEN_FILE.tmp" "$TOKEN_FILE"
  ;;
erase)
  # Skipped when $WALGIT_TOKEN is set; deletes the file and says where a new
  # one comes from (the dead-credential path, driven by the real 401).
  if [ -z "${WALGIT_TOKEN:-}" ]; then
    rm -f "$TOKEN_FILE"
    echo "token erased; mint a new one at {{.Base}}/_auth/tokens" >&2
  fi
  ;;
esac
